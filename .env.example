# Copia este archivo como .env y completa con tus datos de Firebase
# NUNCA subas .env a GitHub — ya está en .gitignore

VITE_FIREBASE_API_KEY=tu-api-key-aqui
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Para GitHub Pages: nombre de tu repositorio (con / al inicio y al final)
# Ejemplo: /worldsticker-2026/
VITE_BASE_URL=/worldsticker-2026/
